** hook of biomass between Balmorel and OptiFlow (FF)
** updated to ensure source and buffer flows respect network topology
** supports source and buffer flows associated with the same fuel in Balmorel
** assumes bb4

*Source processes in PROC_T (require an outgoing arc from PROCSOURCE)
+ SUM((IS3,T,IA,PROCSOURCE,FLOW)$(
      AAAOPTIFLOW(IA)
   AND IFPROC(FFF,PROCSOURCE)
   AND IFFLOW(FFF,FLOW)
   AND RRRAAA(IR,IA)
   AND PROC_T(PROCSOURCE)
   AND SUM(IPROCTO$FLOWFROMTOPROC(IY411,IA,PROCSOURCE,IPROCTO,FLOW),1)
), IHOURSINST(IS3,T)*IHOURFRAC * VFLOWSOURCE(IY411,IA,PROCSOURCE,FLOW,IS3,T))

*Buffer processes in PROC_T (require an incoming arc to PROCBUFFER)
- SUM((IS3,T,IA,PROCBUFFER,FLOW)$(
      AAAOPTIFLOW(IA)
   AND IFPROC(FFF,PROCBUFFER)
   AND IFFLOW(FFF,FLOW)
   AND RRRAAA(IR,IA)
   AND PROC_T(PROCBUFFER)
   AND SUM(IPROCFROM$FLOWFROMTOPROC(IY411,IA,IPROCFROM,PROCBUFFER,FLOW),1)
), IHOURSINST(IS3,T)*IHOURFRAC * VFLOWBUFFER(IY411,IA,PROCBUFFER,FLOW,IS3,T))

*Source processes not in PROC_T (require an outgoing arc from PROCSOURCE)
+ SUM((IS3,T,IA,PROCSOURCE,FLOW)$(
      AAAOPTIFLOW(IA)
   AND IFPROC(FFF,PROCSOURCE)
   AND IFFLOW(FFF,FLOW)
   AND RRRAAA(IR,IA)
   AND NOT PROC_T(PROCSOURCE)
   AND SUM(IPROCTO$FLOWFROMTOPROC(IY411,IA,PROCSOURCE,IPROCTO,FLOW),1)
), IHOURSINSTWWT(IS3,T)*IHOURFRAC * VFLOWSOURCE(IY411,IA,PROCSOURCE,FLOW,IS3,T))

*Buffer processes not in PROC_T (require an incoming arc to PROCBUFFER)
- SUM((IS3,T,IA,PROCBUFFER,FLOW)$(
      AAAOPTIFLOW(IA)
   AND IFPROC(FFF,PROCBUFFER)
   AND IFFLOW(FFF,FLOW)
   AND RRRAAA(IR,IA)
   AND NOT PROC_T(PROCBUFFER)
   AND SUM(IPROCFROM$FLOWFROMTOPROC(IY411,IA,IPROCFROM,PROCBUFFER,FLOW),1)
), IHOURSINSTWWT(IS3,T)*IHOURFRAC * VFLOWBUFFER(IY411,IA,PROCBUFFER,FLOW,IS3,T))
