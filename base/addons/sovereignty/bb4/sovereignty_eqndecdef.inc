*Energy sovereignty addon - FF 2025

******* ELECTRICITY ******

EQUATION QX_SOV_IND  "Net electricity export balance for each sovereign country is neutral or positive";

$ifi %SOV_TIME_RES%==Y_Sov  QX_SOV_IND(C, IY411)$(C_SOV(C)).. 
$ifi %SOV_TIME_RES%==Y_Sov  SUM((IRE,IRI,IS3,T)$(CCCRRR(C, IRE) AND NOT CCCRRR(C, IRI) AND IXK_HASORPOT(IY411, IRE, IRI)), VX_T(IY411, IRE, IRI, IS3, T)) 
$ifi %SOV_TIME_RES%==Y_Sov -SUM((IRE,IRI,IS3,T)$(NOT CCCRRR(C, IRE) AND CCCRRR(C, IRI) AND IXK_HASORPOT(IY411, IRE, IRI)), VX_T(IY411, IRE, IRI, IS3, T)) 

$ifi %SOV_TIME_RES%==S_Sov  QX_SOV_IND(C, IY411, IS3)$(C_SOV(C))..
$ifi %SOV_TIME_RES%==S_Sov  SUM((IRE,IRI,T)$(CCCRRR(C, IRE) AND NOT CCCRRR(C, IRI) AND IXK_HASORPOT(IY411, IRE, IRI)), VX_T(IY411, IRE, IRI, IS3, T))
$ifi %SOV_TIME_RES%==S_Sov -SUM((IRE,IRI,T)$(NOT CCCRRR(C, IRE) AND CCCRRR(C, IRI) AND IXK_HASORPOT(IY411, IRE, IRI)), VX_T(IY411, IRE, IRI, IS3, T))

$ifi %SOV_TIME_RES%==T_Sov  QX_SOV_IND(C, IY411, IS3, T)$(C_SOV(C))..
$ifi %SOV_TIME_RES%==T_Sov  SUM((IRE,IRI)$(CCCRRR(C, IRE) AND NOT CCCRRR(C, IRI) AND IXK_HASORPOT(IY411, IRE, IRI)), VX_T(IY411, IRE, IRI, IS3, T))
$ifi %SOV_TIME_RES%==T_Sov -SUM((IRE,IRI)$(NOT CCCRRR(C, IRE) AND CCCRRR(C, IRI) AND IXK_HASORPOT(IY411, IRE, IRI)), VX_T(IY411, IRE, IRI, IS3, T))

*Sovereign country is net exporter
$ifi     %SOV_NET_EXP%==yes  =G= 0
*Sovereign country is net neutral
$ifi not %SOV_NET_EXP%==yes  =E= 0
;

EQUATION QX_SOV_GRP  "Net electricity export balance from sovereign to non-sovereign groups is neutral or positive";

*** Export between sovereign and non-sovereign regions

$ifi %SOV_TIME_RES%==Y_Sov  QX_SOV_GRP(IY411).. 
$ifi %SOV_TIME_RES%==Y_Sov  SUM((IRE,IRI,IS3,T)$(IR_SOV(IRE) AND IR_NON_SOV(IRI) AND IXK_HASORPOT(IY411,IRE,IRI)),VX_T(IY411,IRE,IRI,IS3,T)) 
$ifi %SOV_TIME_RES%==Y_Sov -SUM((IRI,IRE,IS3,T)$(IR_NON_SOV(IRI) AND IR_SOV(IRE) AND IXK_HASORPOT(IY411,IRI,IRE)),VX_T(IY411,IRI,IRE,IS3,T)) 

$ifi %SOV_TIME_RES%==S_Sov QX_SOV_GRP(IY411, IS3).. 
$ifi %SOV_TIME_RES%==S_Sov  SUM((IRE,IRI,T)$(IR_SOV(IRE) AND IR_NON_SOV(IRI) AND IXK_HASORPOT(IY411,IRE,IRI)),VX_T(IY411,IRE,IRI,IS3,T)) 
$ifi %SOV_TIME_RES%==S_Sov -SUM((IRI,IRE,T)$(IR_NON_SOV(IRI) AND IR_SOV(IRE) AND IXK_HASORPOT(IY411,IRI,IRE)),VX_T(IY411,IRI,IRE,IS3,T)) 

$ifi %SOV_TIME_RES%==T_Sov QX_SOV_GRP(IY411, IS3, T).. 
$ifi %SOV_TIME_RES%==T_Sov  SUM((IRE,IRI)$(IR_SOV(IRE) AND IR_NON_SOV(IRI) AND IXK_HASORPOT(IY411,IRE,IRI)),VX_T(IY411,IRE,IRI,IS3,T)) 
$ifi %SOV_TIME_RES%==T_Sov -SUM((IRI,IRE)$(IR_NON_SOV(IRI) AND IR_SOV(IRE) AND IXK_HASORPOT(IY411,IRI,IRE)),VX_T(IY411,IRI,IRE,IS3,T)) 

*** Balance condition

*Sovereign regions are net exporters
$ifi     %SOV_NET_EXP%==yes  =G= 0

*Sovereign regions are net neutral
$ifi not %SOV_NET_EXP%==yes  =E= 0
;


