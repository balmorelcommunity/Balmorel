****** OPTIFLOW ******

$ifi not %SOV_OPTIFLOW%==yes $goto NO_OPTI_EQ


EQUATION QOPTI_SOV_IND  "Net Optiflow export balance for each sovereign country is neutral or positive";

$ifi %SOV_TIME_RES%==Y_Sov  QOPTI_SOV_IND(C, IY411, FLOW)$(C_SOV(C) AND IFLOWEXIM(FLOW))..
$ifi %SOV_TIME_RES%==Y_Sov  SUM((AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,S,T)$( ICA(C,AAAOPTIFLOW1) AND NOT ICA(C,AAAOPTIFLOW2) AND PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW1,AAAOPTIFLOW2)), VFLOWTRANS(IY411,AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,FLOW,S,T))
$ifi %SOV_TIME_RES%==Y_Sov -SUM((AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,S,T)$( NOT ICA(C,AAAOPTIFLOW1) AND ICA(C,AAAOPTIFLOW2) AND PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ( ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW1,AAAOPTIFLOW2) OR ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW2,AAAOPTIFLOW1) )), VFLOWTRANS(IY411,AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,FLOW,S,T))

$ifi %SOV_TIME_RES%==S_Sov  QOPTI_SOV_IND(C, IY411, FLOW, S)$(C_SOV(C) AND IFLOWEXIM(FLOW))..
$ifi %SOV_TIME_RES%==S_Sov  SUM((AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,T)$( ICA(C,AAAOPTIFLOW1) AND NOT ICA(C,AAAOPTIFLOW2) AND PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW1,AAAOPTIFLOW2)), VFLOWTRANS(IY411,AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,FLOW,S,T))
$ifi %SOV_TIME_RES%==S_Sov -SUM((AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,T)$( NOT ICA(C,AAAOPTIFLOW1) AND ICA(C,AAAOPTIFLOW2) AND PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ( ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW1,AAAOPTIFLOW2) OR ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW2,AAAOPTIFLOW1) )), VFLOWTRANS(IY411,AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,FLOW,S,T))

$ifi %SOV_TIME_RES%==T_Sov  QOPTI_SOV_IND(C, IY411, FLOW, S, T)$(C_SOV(C) AND IFLOWEXIM(FLOW))..
$ifi %SOV_TIME_RES%==T_Sov  SUM((AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC)$( ICA(C,AAAOPTIFLOW1) AND NOT ICA(C,AAAOPTIFLOW2) AND PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW1,AAAOPTIFLOW2)), VFLOWTRANS(IY411,AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,FLOW,S,T))
$ifi %SOV_TIME_RES%==T_Sov -SUM((AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC)$( NOT ICA(C,AAAOPTIFLOW1) AND ICA(C,AAAOPTIFLOW2) AND PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ( ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW1,AAAOPTIFLOW2) OR ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW2,AAAOPTIFLOW1) )), VFLOWTRANS(IY411,AAAOPTIFLOW1,AAAOPTIFLOW2,IPROC,FLOW,S,T))

*Sovereign country is net exporter
$ifi     %SOV_NET_EXP%==yes  =G= 0
*Sovereign country is net neutral
$ifi not %SOV_NET_EXP%==yes  =E= 0
;

EQUATION QOPTI_SOV_GRP  "Net export balance for Optiflow transport processes from sovereign to non-sovereign countries is neutral or positive";

$ifi %SOV_TIME_RES%==Y_Sov QOPTI_SOV_GRP(IY411,FLOW)$(IFLOWEXIM(FLOW)).. 
$ifi %SOV_TIME_RES%==Y_Sov   SUM((AAAOPTIFLOW_SOV,AAAOPTIFLOW_NON_SOV,IPROC,S,T)$(PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW_SOV,AAAOPTIFLOW_NON_SOV)), VFLOWTRANS(IY411,AAAOPTIFLOW_SOV,AAAOPTIFLOW_NON_SOV,IPROC,FLOW,S,T))
$ifi %SOV_TIME_RES%==Y_Sov  -SUM((AAAOPTIFLOW_NON_SOV,AAAOPTIFLOW_SOV,IPROC,S,T)$(PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW_NON_SOV,AAAOPTIFLOW_SOV)), VFLOWTRANS(IY411,AAAOPTIFLOW_NON_SOV,AAAOPTIFLOW_SOV,IPROC,FLOW,S,T))

