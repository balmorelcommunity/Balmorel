$ifi %SOV_TIME_RES%==S_Sov   SUM((AAAOPTIFLOW_SOV,AAAOPTIFLOW_NON_SOV,IPROC,T)$(PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW_SOV,AAAOPTIFLOW_NON_SOV)), VFLOWTRANS(IY411,AAAOPTIFLOW_SOV,AAAOPTIFLOW_NON_SOV,IPROC,FLOW,S,T))
$ifi %SOV_TIME_RES%==S_Sov  -SUM((AAAOPTIFLOW_NON_SOV,AAAOPTIFLOW_SOV,IPROC,T)$(PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW_NON_SOV,AAAOPTIFLOW_SOV)), VFLOWTRANS(IY411,AAAOPTIFLOW_NON_SOV,AAAOPTIFLOW_SOV,IPROC,FLOW,S,T))

$ifi %SOV_TIME_RES%==T_Sov QOPTI_SOV_GRP(IY411,FLOW,S,T)$(IFLOWEXIM(FLOW)).. 
$ifi %SOV_TIME_RES%==T_Sov   SUM((AAAOPTIFLOW_SOV,AAAOPTIFLOW_NON_SOV,IPROC)$(PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW_SOV,AAAOPTIFLOW_NON_SOV)), VFLOWTRANS(IY411,AAAOPTIFLOW_SOV,AAAOPTIFLOW_NON_SOV,IPROC,FLOW,S,T))
$ifi %SOV_TIME_RES%==T_Sov  -SUM((AAAOPTIFLOW_NON_SOV,AAAOPTIFLOW_SOV,IPROC)$(PROCEXIM(IPROC) AND ALLOWEDTRANS(IPROC,FLOW) AND ITRANSFROMTOPROC(IPROC,AAAOPTIFLOW_NON_SOV,AAAOPTIFLOW_SOV)), VFLOWTRANS(IY411,AAAOPTIFLOW_NON_SOV,AAAOPTIFLOW_SOV,IPROC,FLOW,S,T))

*Sovereign regions are net exporters
$ifi     %SOV_NET_EXP%==yes  =G= 0
*Sovereign regions are net neutral
$ifi not %SOV_NET_EXP%==yes  =E= 0
;

