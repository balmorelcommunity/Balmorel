* Scenario-local DH.inc wrapper: base + A1 heat-area aggregation.
* AAAGG_* sets declared in scenario AGKN.inc (loaded before this).
$INCLUDE '../../base/data/DH.inc'

DH(YYY,'DK1_Large',DHUSER)   = DH(YYY,'DK1_Large',DHUSER)   + SUM(AAAGG_DK1, DH(YYY,AAAGG_DK1,DHUSER));
DH(YYY,'DK2_Large',DHUSER)   = DH(YYY,'DK2_Large',DHUSER)   + SUM(AAAGG_DK2, DH(YYY,AAAGG_DK2,DHUSER));
DH(YYY,'FI_large',DHUSER)    = DH(YYY,'FI_large',DHUSER)    + SUM(AAAGG_FI,  DH(YYY,AAAGG_FI,DHUSER));
DH(YYY,'SE1_medium',DHUSER)  = DH(YYY,'SE1_medium',DHUSER)  + SUM(AAAGG_SE1, DH(YYY,AAAGG_SE1,DHUSER));
DH(YYY,'SE2_medium',DHUSER)  = DH(YYY,'SE2_medium',DHUSER)  + SUM(AAAGG_SE2, DH(YYY,AAAGG_SE2,DHUSER));
DH(YYY,'SE3_large',DHUSER)   = DH(YYY,'SE3_large',DHUSER)   + SUM(AAAGG_SE3, DH(YYY,AAAGG_SE3,DHUSER));
DH(YYY,'SE4_large',DHUSER)   = DH(YYY,'SE4_large',DHUSER)   + SUM(AAAGG_SE4, DH(YYY,AAAGG_SE4,DHUSER));
DH(YYY,'EE_Tallinn',DHUSER)  = DH(YYY,'EE_Tallinn',DHUSER)  + SUM(AAAGG_EE,  DH(YYY,AAAGG_EE,DHUSER));
DH(YYY,'LT_VilU',DHUSER)     = DH(YYY,'LT_VilU',DHUSER)     + SUM(AAAGG_LT,  DH(YYY,AAAGG_LT,DHUSER));
DH(YYY,'LV_RigaR',DHUSER)    = DH(YYY,'LV_RigaR',DHUSER)    + SUM(AAAGG_LV,  DH(YYY,AAAGG_LV,DHUSER));

DH(YYY,AAAGG_DK1,DHUSER) = 0;
DH(YYY,AAAGG_DK2,DHUSER) = 0;
DH(YYY,AAAGG_FI,DHUSER)  = 0;
DH(YYY,AAAGG_SE1,DHUSER) = 0;
DH(YYY,AAAGG_SE2,DHUSER) = 0;
DH(YYY,AAAGG_SE3,DHUSER) = 0;
DH(YYY,AAAGG_SE4,DHUSER) = 0;
DH(YYY,AAAGG_EE,DHUSER)  = 0;
DH(YYY,AAAGG_LT,DHUSER)  = 0;
DH(YYY,AAAGG_LV,DHUSER)  = 0;
