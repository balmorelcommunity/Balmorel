* Scenario-local GKFX.inc wrapper: base + A1 heat-area aggregation.
* AAAGG_* sets declared in scenario AGKN.inc (loaded before this).
$INCLUDE '../../base/data/GKFX.inc'

GKFX(YYY,'DK1_Large',GGG)   = GKFX(YYY,'DK1_Large',GGG)   + SUM(AAAGG_DK1, GKFX(YYY,AAAGG_DK1,GGG));
GKFX(YYY,'DK2_Large',GGG)   = GKFX(YYY,'DK2_Large',GGG)   + SUM(AAAGG_DK2, GKFX(YYY,AAAGG_DK2,GGG));
GKFX(YYY,'FI_large',GGG)    = GKFX(YYY,'FI_large',GGG)    + SUM(AAAGG_FI,  GKFX(YYY,AAAGG_FI,GGG));
GKFX(YYY,'SE1_medium',GGG)  = GKFX(YYY,'SE1_medium',GGG)  + SUM(AAAGG_SE1, GKFX(YYY,AAAGG_SE1,GGG));
GKFX(YYY,'SE2_medium',GGG)  = GKFX(YYY,'SE2_medium',GGG)  + SUM(AAAGG_SE2, GKFX(YYY,AAAGG_SE2,GGG));
GKFX(YYY,'SE3_large',GGG)   = GKFX(YYY,'SE3_large',GGG)   + SUM(AAAGG_SE3, GKFX(YYY,AAAGG_SE3,GGG));
GKFX(YYY,'SE4_large',GGG)   = GKFX(YYY,'SE4_large',GGG)   + SUM(AAAGG_SE4, GKFX(YYY,AAAGG_SE4,GGG));
GKFX(YYY,'EE_Tallinn',GGG)  = GKFX(YYY,'EE_Tallinn',GGG)  + SUM(AAAGG_EE,  GKFX(YYY,AAAGG_EE,GGG));
GKFX(YYY,'LT_VilU',GGG)     = GKFX(YYY,'LT_VilU',GGG)     + SUM(AAAGG_LT,  GKFX(YYY,AAAGG_LT,GGG));
GKFX(YYY,'LV_RigaR',GGG)    = GKFX(YYY,'LV_RigaR',GGG)    + SUM(AAAGG_LV,  GKFX(YYY,AAAGG_LV,GGG));

GKFX(YYY,AAAGG_DK1,GGG) = 0;
GKFX(YYY,AAAGG_DK2,GGG) = 0;
GKFX(YYY,AAAGG_FI,GGG)  = 0;
GKFX(YYY,AAAGG_SE1,GGG) = 0;
GKFX(YYY,AAAGG_SE2,GGG) = 0;
GKFX(YYY,AAAGG_SE3,GGG) = 0;
GKFX(YYY,AAAGG_SE4,GGG) = 0;
GKFX(YYY,AAAGG_EE,GGG)  = 0;
GKFX(YYY,AAAGG_LT,GGG)  = 0;
GKFX(YYY,AAAGG_LV,GGG)  = 0;
